<?xml version="1.0"?>
<robot name="orchard_rover">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <end_effector name="tool" parent_link="tool0" group="arm"/>
  <group_state name="home" group="arm">
    <joint name="J1" value="0"/>
    <joint name="J2" value="0"/>
    <joint name="J3" value="0"/>
    <joint name="J4" value="0"/>
    <joint name="J5" value="0"/>
    <joint name="J6" value="0"/>
  </group_state>
  <group_state name="transport" group="arm">
    <joint name="J1" value="3.14159265"/>
    <joint name="J2" value="1.04719755"/>
    <joint name="J3" value="-2.0943951"/>
    <joint name="J4" value="0"/>
    <joint name="J5" value="1.04719755"/>
    <joint name="J6" value="0"/>
  </group_state>
  <disable_collisions link1="base_link" link2="j1_link" reason="Adjacent"/>
  <disable_collisions link1="j1_link" link2="upper_arm" reason="Adjacent"/>
  <disable_collisions link1="upper_arm" link2="forearm_root" reason="Adjacent"/>
  <disable_collisions link1="forearm_root" link2="forearm_tube" reason="Adjacent"/>
  <disable_collisions link1="forearm_tube" link2="wrist" reason="Adjacent"/>
  <disable_collisions link1="wrist" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
</robot>
